{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "content:sync": "node scripts/sync-content-schema.mjs",
    "content:fallback": "tsx src/scripts/export-fallback.ts",
    "content:code-css": "tsx src/scripts/generate-code-css.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "db:migrate-richtext": "tsx src/db/migrate-richtext-cli.ts",
    "media:reprocess": "tsx src/db/media-reprocess-cli.ts",
    "ai:eval": "tsx src/ask/evals/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/provider": "^4.0.35",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@langchain/core": "^1.3.4",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@sentry/node": "^11.10.0",
    "ai": "^7.0.162",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "js-tiktoken": "^1.0.21",
    "minisearch": "^7.2.0",
    "otpauth": "^9.6.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
