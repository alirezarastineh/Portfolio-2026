# The client image's public build values for production (plan Phase 12): the
# API its browser bundle calls, Sentry, Umami and Turnstile. The browser sees
# every one of them, so none may be a secret: secrets never take a VITE_ name.
# - .woodpecker/deploy.yaml builds the client image with them.
# - rollout.sh exports them on the host, so the SSR container's CSP allows what
#   that bundle calls, whatever the host's .env says.
# The manual deploys in DEPLOYMENT.md build from the host's .env instead: keep
# its VITE_* lines equal to these.
# Plain KEY=value lines, without quotes or spaces: sh reads this file as well
# as load-env.sh.
VITE_API_BASE_URL=https://api.alirezarastineh.me
VITE_SENTRY_DSN=https://6193f84d0d7b631e790d2e3ea9046107@o4509915600388096.ingest.de.sentry.io/4512129607270480
VITE_UMAMI_SRC=https://analytics.alirezarastineh.me/script.js
VITE_UMAMI_WEBSITE_ID=87f18c73-1a00-4cdc-ae9a-b4ba350c1602
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFDNDo_SAGd5Xuqv
