/* The TypeScript that runs in Node rather than in the app: the tool configs,
   the build plugins they load and the scripts. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Vite's native config loader runs vite.config.ts with Node's type
    // stripping, which needs every relative import to name its `.ts` file.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.ts",
    "vite-plugins/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["vite-plugins/**/*.spec.ts"]
}
